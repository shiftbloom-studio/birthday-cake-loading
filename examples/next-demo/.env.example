# Copy to .env (not committed) or set these as build variables in Workers Builds.
# All values are read at build time.

# Deployment (cloudflare.config.ts)
BCL_DEMO_WORKER_NAME=birthday-cake-loading-demo
# Custom domain; leave empty to deploy to workers.dev only
BCL_DEMO_HOSTNAME=

# Imprint and privacy policy (/imprint, /impressum, /privacy, /datenschutz)
OPERATOR_NAME=Jane Doe
OPERATOR_BUSINESS=Example studio
OPERATOR_STREET=Example Street 1
OPERATOR_CITY=12345 Example City
OPERATOR_COUNTRY_EN=Germany
OPERATOR_COUNTRY_DE=Deutschland
OPERATOR_EMAIL=hello@example.com
# Optional
OPERATOR_PHONE=
OPERATOR_VAT_ID=
SUPERVISORY_AUTHORITY=
